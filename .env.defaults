# Default configuration for sprint tools.
# Copy this to .env and override values as needed.
# .env is gitignored; .env.defaults is committed.
#
# JIRA_BACKEND:
#   server — Silabs Jira Server/DC (Bearer personal access token)
#   cloud  — Atlassian Jira Cloud (Basic email + API token)

JIRA_BACKEND=server
JIRA_BASE_URL=https://jira.silabs.com
# JIRA_TOKEN=your-personal-access-token

# --- Atlassian Cloud example ---
# JIRA_BACKEND=cloud
# JIRA_BASE_URL=https://siliconlabs.atlassian.net
# JIRA_USER=you@silabs.com
# JIRA_TOKEN=your-atlassian-api-token
